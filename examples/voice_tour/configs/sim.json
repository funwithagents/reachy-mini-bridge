{
  "backend": "sim",
  "daemon": {
    "spawn": "auto",
    "headless": false,
    "scene": "minimal",
    "camera": {
      "source": "webcam",
      "hfov_deg": 70.0
    },
    "sim_displays": {
      "camera_overlay": true,
      "face_markers": true
    }
  },
  "face_detection": {
    "detector": "yunet",
    "enabled": true,
    "width": 640,
    "target_fps": null
  },
  "motion": {
    "presence": true,
    "idle": "breathing",
    "wobbling": true,
    "tracking": true
  }
}
