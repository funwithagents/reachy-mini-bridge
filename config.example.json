{
  "backend": "sim",
  "robot": {
    "host": "127.0.0.1",
    "port": 8000,
    "connection_mode": "network",
    "media_backend": "local",
    "timeout": 5.0
  },
  "daemon": {
    "spawn": "auto",
    "headless": false,
    "scene": null,
    "camera": {
      "source": "webcam",
      "device": null,
      "hfov_deg": 70.0
    },
    "sim_displays": {
      "camera_overlay": true,
      "robot_gaze": true,
      "face_markers": true
    },
    "preload_datasets": true,
    "startup_timeout": 45.0
  },
  "tts": {
    "module": {
      "type": "pocket",
      "voice": "george",
      "device": "auto"
    }
  },
  "audio": {
    "xvf3800": null
  },
  "face_detection": {
    "detector": "yunet",
    "enabled": true,
    "width": 640,
    "target_fps": null
  },
  "motion": {
    "presence": true,
    "idle": "breathing",
    "wobbling": true,
    "tracking": true
  }
}
